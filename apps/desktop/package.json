{
  "name": "@otomat/desktop",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "imports": {
    "#shared/*": "./src/shared/*.ts",
    "#main/*": "./src/main/*.ts",
    "#preload/*": "./src/preload/*.ts",
    "#scripts/*": "./scripts/*.mjs",
    "#release/*": "./scripts/release/*.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "prepare-daemon": "node scripts/prepare-daemon.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@otomat/client": "workspace:*",
    "@otomat/domain": "workspace:*",
    "@types/node": "^26.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.10"
  }
}
