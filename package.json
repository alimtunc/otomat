{
  "name": "otomat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @otomat/web dev",
    "back": "pnpm --filter @otomat/local-daemon start",
    "build": "pnpm -r run build && pnpm run boundaries",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint apps packages",
    "lint:react": "oxlint --config .oxlintrc.react.json apps/web packages/ui",
    "guard:react": "pnpm run lint:react && react-doctor --yes --include-untracked --no-telemetry --no-supply-chain --no-dead-code",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages",
    "boundaries": "node scripts/import-boundaries.mjs",
    "guardrails": "node --test scripts/anti-slop.test.mjs scripts/guardrails.test.mjs scripts/react-doctor.test.mjs scripts/react-lint.test.mjs && node scripts/guardrails.mjs",
    "test:scripts": "node --test \"scripts/preview/**/*.test.mjs\" \"scripts/ci/**/*.test.mjs\"",
    "smoke:dist": "pnpm --filter @otomat/local-daemon smoke:dist",
    "check:static": "pnpm run format:check && pnpm run lint && pnpm run guard:react && pnpm run guardrails && pnpm run test:scripts",
    "check:build": "pnpm run build && pnpm run typecheck && pnpm run smoke:dist",
    "test:packages": "pnpm --filter '!@otomat/web' --filter '!@otomat/local-daemon' -r run test",
    "check": "pnpm run check:static && pnpm run check:build && pnpm run test",
    "desktop:dev": "node apps/desktop/scripts/dev.mjs",
    "desktop:package": "node apps/desktop/scripts/package-mac.mjs",
    "desktop:preflight": "node apps/desktop/scripts/release-preflight.mjs",
    "desktop:release": "node apps/desktop/scripts/release-mac.mjs",
    "desktop:smoke": "node apps/desktop/scripts/smoke/packaged.mjs",
    "desktop:smoke:local": "node apps/desktop/scripts/smoke/local-upgrade.mjs",
    "db:migrate": "pnpm --filter @otomat/db run migrate",
    "clean:data": "node scripts/clean-dev-data.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@otomat/domain": "workspace:*",
    "@otomat/tooling": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "lefthook": "^2.1.12",
    "oxfmt": "~0.66.0",
    "oxlint": "1.81.0",
    "react-doctor": "0.9.13"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
