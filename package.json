{
  "name": "otomat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @otomat/web dev",
    "back": "pnpm --filter @otomat/local-daemon start",
    "build": "pnpm -r run build && pnpm run boundaries",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint apps packages",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages",
    "boundaries": "node scripts/import-boundaries.mjs",
    "guardrails": "node --test scripts/guardrails.test.mjs && node scripts/guardrails.mjs",
    "test:scripts": "node --test scripts/preview/remote.test.mjs",
    "smoke:dist": "pnpm --filter @otomat/local-daemon smoke:dist",
    "check": "pnpm run format:check && pnpm run lint && pnpm run guardrails && pnpm run test:scripts && pnpm run build && pnpm run typecheck && pnpm run smoke:dist && pnpm run test",
    "desktop:dev": "node apps/desktop/scripts/dev.mjs",
    "desktop:package": "node apps/desktop/scripts/package-mac.mjs",
    "desktop:preflight": "node apps/desktop/scripts/release-preflight.mjs",
    "desktop:release": "node apps/desktop/scripts/release-mac.mjs",
    "desktop:smoke": "node apps/desktop/scripts/smoke/packaged.mjs",
    "desktop:smoke:local": "node apps/desktop/scripts/smoke/local-upgrade.mjs",
    "db:migrate": "pnpm --filter @otomat/db run migrate",
    "clean:data": "node scripts/clean-dev-data.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@otomat/domain": "workspace:*",
    "@otomat/tooling": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "lefthook": "^2.1.10",
    "oxfmt": "~0.63.0",
    "oxlint": "1.79.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
