// One Worker per pull request: scripts/preview/instance.mjs renders this template into
// wrangler.generated.jsonc with "name" set to otomat-preview-pr-<n> and deploys that, because
// --name would rename the script but leave every pull request colliding on one container
// application named after this file's "name".
{
  "name": "otomat-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "containers": [
    {
      "class_name": "PreviewDaemon",
      "image": "./Dockerfile",
      "instance_type": "basic",
      // Two, not one: after a push the previous commit's instance may still be draining
      // while the new build's container starts.
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PREVIEW_DAEMON", "class_name": "PreviewDaemon" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PreviewDaemon"] }]
}
